{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kinlycarepro.com.au"
        }
      ],
      "destination": "https://www.kinlycarepro.com.au/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/features", "destination": "/index.html" },
    { "source": "/solutions", "destination": "/index.html" },
    { "source": "/solutions/ndis-provider-software", "destination": "/index.html" },
    { "source": "/solutions/disability-service-provider-software", "destination": "/index.html" },
    { "source": "/solutions/care-management-software", "destination": "/index.html" },
    { "source": "/solutions/ndis-rostering-software", "destination": "/index.html" },
    { "source": "/solutions/participant-management-software", "destination": "/index.html" },
    { "source": "/solutions/ndis-invoicing-claiming-software", "destination": "/index.html" },
    { "source": "/solutions/disability-support-worker-scheduling-software", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/vs/shiftcare", "destination": "/index.html" },
    { "source": "/vs/deputy", "destination": "/index.html" },
    { "source": "/vs/care-master", "destination": "/index.html" },
    { "source": "/vs/myp", "destination": "/index.html" },
    { "source": "/vs/nightingale", "destination": "/index.html" },
    { "source": "/guardian-ai", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/why-participant-pricing", "destination": "/index.html" },
    { "source": "/ndis-price-guide", "destination": "/index.html" },
    { "source": "/resources", "destination": "/index.html" },
    { "source": "/resources/ndis-progress-notes-guide", "destination": "/index.html" },
    { "source": "/resources/ndis-billing-guide", "destination": "/index.html" },
    { "source": "/resources/ndis-rostering-software-guide", "destination": "/index.html" },
    { "source": "/resources/ndis-audit-preparation-guide", "destination": "/index.html" },
    { "source": "/resources/ndis-software-buyers-checklist", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/compliance", "destination": "/index.html" },
    { "source": "/security", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    }
  ]
}
